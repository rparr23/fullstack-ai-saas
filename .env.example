# Copy to .env for local development. Mock mode needs no external credentials.
AI_PROVIDER=mock
API_PORT=8787
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8787
VITE_DEMO_MODE=true
# Configure these in hosted environments; never expose service-role or OpenAI keys to Vite.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
